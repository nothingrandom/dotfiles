nts_2.EXTENSION_ROOT_DIR, 'experiments.json');\nexports.configUri = 'https://raw.githubusercontent.com/microsoft/vscode-python/master/experiments.json';\nexports.EXPERIMENTS_EFFORT_TIMEOUT_MS = 2000;\n// The old experiments which are working fine using the `SHA512` algorithm\nexports.oldExperimentSalts = ['ShowExtensionSurveyPrompt', 'ShowPlayIcon', 'AlwaysDisplayTestExplorer', 'LS'];\n/**\n * Manages and stores experiments, implements the AB testing functionality\n */\nlet ExperimentsManager = class ExperimentsManager {\n    constructor(persistentStateFactory, httpClient, crypto, appEnvironment, output, fs, configurationService, experimentEffortTimeout = exports.EXPERIMENTS_EFFORT_TIMEOUT_MS) {\n        this.persistentStateFactory = persistentStateFactory;\n        this.httpClient = httpClient;\n        this.crypto = crypto;\n        this.appEnvironment = appEnvironment;\n        this.output = output;\n        this.fs = fs;\n        this.configurationService = configurationService;\n        this.experimentEffortTimeout = experimentEffortTimeout;\n        /**\n         * Keeps track of the list of experiments user is in\n         */\n        this.userExperiments = [];\n        /**\n         * Experiments user requested to opt into manually\n         */\n        this._experimentsOptedInto = [];\n        /**\n         * Experiments user requested to opt out from manually\n         */\n        this._experimentsOptedOutFrom = [];\n        /**\n         * Returns `true` if experiments are enabled, else `false`.\n         */\n        this._enabled = true;\n        this.activatedOnce = false;\n        this.isDownloadedStorageValid = this.persistentStateFactory.createGlobalPersistentState(exports.isDownloadedStorageValidKey, false, EXPIRY_DURATION_MS);\n        this.experimentStorage = this.persistentStateFactory.createGlobalPersistentState(exports.experimentStorageKey, undefined);\n        this.downloadedExperimentsStorage = this.persistentStateFactory.createGlobalPersistentState(exports.downloadedExperimentStorageKey, undefined);\n    }\n    async activate() {\n        if (this.activatedOnce) {\n            return;\n        }\n        this.activatedOnce = true;\n        this.settings = this.configurationService.getSettings(undefined);\n        this._experimentsOptedInto = this.settings.experiments.optInto;\n        this._experimentsOptedOutFrom = this.settings.experiments.optOutFrom;\n        this._enabled = this.settings.experiments.enabled;\n        if (!this._enabled) {\n            telemetry_1.sendTelemetryEvent(constants_1.EventName.PYTHON_EXPERIMENTS_DISABLED);\n            return;\n        }\n        await this.updateExperimentStorage();\n        this.populateUserExperiments();\n        for (const exp of this.userExperiments || []) {\n            // We need to know whether an experiment influences the logs we observe in github issues, so log the experiment group\n            this.output.appendLine(localize_1.Experiments.inGroup().format(exp.name));\n        }\n        this.initializeInBackground().ignoreErrors();\n    }\n    inExperiment(experimentName) {\n        if (!this._enabled) {\n            return false;\n        }\n        this.sendTelemetryIfInExperiment(experimentName);\n        return this.userExperiments.find((exp) => exp.name === experimentName) ? true : false;\n    }\n    /**\n     * Populates list of experiments user is in\n     */\n    populateUserExperiments() {\n        this.cleanUpExperimentsOptList();\n        if (Array.isArray(this.experimentStorage.value)) {\n            for (const experiment of this.experimentStorage.value) {\n                try {\n                    if (this._experimentsOptedOutFrom.includes('All') ||\n                        this._experimentsOptedOutFrom.includes(experiment.name)) {\n                        telemetry_1.sendTelemetryEvent(constants_1.EventName.PYTHON_EXPERIMENTS_OPT_IN_OUT, undefined, {\n                            expNameOptedOutOf: experiment.name\n               