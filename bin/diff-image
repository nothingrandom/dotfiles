#!/bin/bash
set -euo pipefail

usage()
{
    echo "Usage: $0 [<options>] <file1> <file2>"
    echo
    echo "Options:"
    echo "  -h         Print this help."
    echo "  -b <color> Use this as the background color; defaults to white."
    echo "  -c <color> Highlight differences with this color; defaults to red."
    echo "  -e         Show Exif differences only; don't compare the image data."
    echo "  -f <fuzz>  Use the specified percentage of fuzz.  Defaults to "
    echo "                 5% for JPEGs, zero otherwise."
    echo "  -n <name>  The name to give the first file."
    echo "  -N <name>  The name to give the second file."
    echo
}

backgroundcolor=
color=
exif_only=false
fuzz=
name1=
name2=
while getopts "hb:c:ef:n:N:" opt
do
    case "$opt" in
    h)
        usage
        exit 0
        ;;
    b)
        backgroundcolor="$OPTARG"
        ;;
    c)
        color="$OPTARG"
        ;;
    e)
        exif_only=true
        ;;
    f)
        fuzz="$OPTARG"
        ;;
    n)
        name1="$OPTARG"
        ;;
    N)
        name2="$OPTARG"
        ;;
    esac
done
shift $(( OPTIND - 1 ))

if [ -z "${1-}" ] || [ -z "${2-}" ]
then
    usage
    exit 1
fi

f1="$1"
f2="$2"

if [[ "$f1" != '/dev/null' ]] && [[ ! -f "$f1" ]]
then
    echo "$f1: No such file." >&2
    exit 1
fi

if [[ -d "$f2" ]]
then
   f=$(basename "$f1")
   f2="$f2/$f"
fi

if [[ "$f2" != '/dev/null' ]] && [[ ! -f "$f2" ]]
then
    echo "$f2: No such file." >&2
    usage
    exit 1
fi

if [[ -z "$name1" ]]
then
    name1="$f1"
fi
if [[ -z "$name2" ]]
then
    name2="$f2"
fi

tmpfiles=()
cleanup()
{
    if [ ${#tmpfiles[@]} -gt 0 ]
    then
        rm -f "${tmpfiles[@]}"
    fi
}
trap cleanup EXIT

displayname="$name1"
if [ "$displayname" = /dev/null ]
then
    displayname="$name2"
fi

ext="${displayname##*.}"

if diff "$f1" "$f2" >/dev/null
then
  exit 0
fi

exif()
{
    if [[ "$1" = /dev/null ]]
    then
        echo /dev/null
        return
    fi

    local b="$(basename "$1")"
    local d="$(mktemp -t "$b.XXXXXX")"
    tmpfiles+=("$d")

    exiftool "$1" | grep -v 'File Name' | \
                    grep -v 'Directory' | \
                    grep -v 'ExifTool Version Number' | \
                    grep -v 'File Inode Change' | \
                    grep -v 'File Access Date/Time' | \
                    grep -v 'File Modification Date/Time' | \
                    grep -v 'File Permissions' | \
                    grep -v 'File Type Extension' \
        >"$d"
    echo "$d"
}


diff_clean_names()
{
    diff -u "$1" --label "$name1" "$2" --label "$name2" || true
}

exifdiff=
if which exiftool > /dev/null
then
  d1="$(exif "$f1")"
  d2="$(exif "$f2")"
  diff_clean_names "$d1" "$d2"
  set +e
  diff -q "$d1" "$d2" >/dev/null
  exifdiff=$?
  set -e
else
  diff_clean_names "$f1" "$f2"
fi

if $exif_only
then
    exit 0
fi

im()
{
    if which magick > /dev/null 2>&1
    then
        magick "$@"
    else
        convert "$@"
    fi
}

if \
    ! which compare > /dev/null || \
    ( ! which magick > /dev/null && ! which convert > /dev/null )
then
    echo 'ImageMagick is not installed.' >&2
    exit 1
fi

if [[ $exifdiff = 0 ]] && compare "$f1" "$f2" /dev/null 2>/dev/null
then
    exit 0
fi

bn="$(basename "$displayname")"

# With OUTDIR set, a wrapper is collecting every image in one `git diff` run so
# it can open them as a single batch instead of one viewer window per file.
if [ -n "${GIT_DIFF_IMAGE_OUTDIR-}" ]
then
    destdir="$GIT_DIFF_IMAGE_OUTDIR"
else
    destdir="$(mktemp -d -t diff-image.XXXXXX)"
fi
stem="${bn%.*}"
destfile="$destdir/$stem.png"
n=1
while [ -e "$destfile" ]
do
    destfile="$destdir/$stem-$n.png"
    n=$(( n + 1 ))
done

if [ -z "$fuzz" ] && ( [ "$ext" = "jpeg" ] || [ "$ext" = "jpg" ] )
then
    fuzz='5'
fi

backgroundcolor_flag=
if [ -n "$backgroundcolor" ]
then
    backgroundcolor_flag="-background $backgroundcolor"
fi

color_flag=
if [ -n "$color" ]
then
    color_flag="-highlight-color $color"
fi

fuzz_flag=
if [ -n "$fuzz" ]
then
    fuzz_flag="-fuzz $fuzz%"
fi

do_compare()
{
    local panes=()

    # An added or deleted image has only one side; there is nothing to compare,
    # and feeding /dev/null to ImageMagick just errors out.
    if [ "$f1" = /dev/null ]
    then
        panes=("$f2")
    elif [ "$f2" = /dev/null ]
    then
        panes=("$f1")
    else
        local diffpng="$(mktemp -t "$bn.diff.XXXXXX")"
        tmpfiles+=("$diffpng")

        # compare exits non-zero whenever the images differ, which is the whole
        # point here, so its status says nothing about success. An empty result
        # does: that means compare bailed, usually on a dimension mismatch.
        compare $color_flag $fuzz_flag $backgroundcolor_flag \
            "$f1" "$f2" "png:$diffpng" 2>/dev/null || true

        if [ -s "$diffpng" ]
        then
            panes=("$f1" "$diffpng" "$f2")
        else
            echo "diff-image: $name1 and $name2 are not directly comparable; showing both." >&2
            panes=("$f1" "$f2")
        fi
    fi

    # +append rather than montage: Homebrew ships ImageMagick with an empty
    # font typemap, and montage needs a font to lay out its cells even when
    # labels are off, so it fails on every invocation there.
    local bg="${backgroundcolor:-white}"
    if ! im -background "$bg" "${panes[@]}" -splice 8x0 +append \
            -bordercolor "$bg" -border 4 "png:$destfile"
    then
        echo "diff-image: could not assemble comparison for $name1" >&2
        return 1
    fi
}

# Compositing a very wide image is slow and the result is unreadable anyway,
# so hand the originals to the viewer side by side instead.
w=$(exiftool -p '$ImageWidth' "$f1" 2>/dev/null || true)
huge=false
if [[ ${w:-0} -ge 10000 ]]
then
    huge=true
fi

copy_originals()
{
    local side
    for side in "$f1" "$f2"
    do
        if [ "$side" != /dev/null ]
        then
            cp "$side" "$destdir/$stem-$(basename "$side").png"
        fi
    done
}

if [ -n "${GIT_DIFF_IMAGE_OUTDIR-}" ]
then
    if $huge
    then
        copy_originals
    else
        do_compare || true
    fi
    exit 0
fi

opener=open
if which xdg-open > /dev/null
then
    opener=xdg-open
fi

if $huge
then
    copy_originals
    "$opener" "$destdir"/*.png
else
    do_compare && "$opener" "$destfile"
fi
