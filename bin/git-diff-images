#!/bin/bash
set -euo pipefail

# git calls this as a diff driver with 7 arguments. Running it by hand is
# almost always a mix-up with the user-facing `git diff-image` alias.
if [ $# -lt 1 ]
then
    echo "$(basename "$0") is a git diff driver, not a command to run directly." >&2
    echo "To see image diffs, run:  git diff-image   (aliased to 'gdi')" >&2
    echo "Plain 'git diff' shows image metadata only." >&2
    exit 1
fi

name="$1"
f1="${2-/dev/null}"
f2="${5-/dev/null}"

name1="a/$name"
name2="b/$name"

if [ "$f1" = /dev/null ]
then
    name1=/dev/null
fi
if [ "$f2" = /dev/null ]
then
    name2=/dev/null
fi


if diff "$f1" "$f2" >/dev/null
then
  exit 0
fi

readlink_f()
{
    if [ $(uname) = 'Darwin' ]
    then
        local f=$(readlink "$1")
        if [ -z "$f" ]
        then
            f="$1"
        fi
        local d=$(dirname "$f")
        local b=$(basename "$f")
        if [ -d "$d" ]
        then
            (cd "$d" && echo "$(pwd -P)/$b")
        elif [[ "$d" = /* ]]
        then
            echo "$f"
        elif [[ "$d" = ./* ]]
        then
            echo "$(pwd -P)/${f/.\//}"
        else
            echo "$(pwd -P)/$f"
        fi
    else
        readlink -f "$1"
    fi
}

thisdir="$(dirname $(readlink_f "$0"))"

e_flag=''
if [ -z "${GIT_DIFF_IMAGE_ENABLED-}" ] || \
   ! which compare > /dev/null || \
   ( ! which magick > /dev/null && ! which convert > /dev/null )
then
  e_flag='-e'
fi

exec "$thisdir/diff-image" $e_flag -n "$name1" -N "$name2" "$f1" "$f2"
